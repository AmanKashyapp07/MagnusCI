# =============================================================================
# MagnusCI Environment Configuration Template
# Copy to backend/.env and adjust values for your local environment
# =============================================================================

# Server & Runtime Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5001/ci

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ci_cd_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis Queue & Pub/Sub Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Authentication & Security Secrets
JWT_SECRET=demo_jwt_secret_change_in_production
GITHUB_WEBHOOK_SECRET=demo_webhook_secret_change_in_production

# Optional GitHub Integration Credentials
# (Builds execute locally without these; required only for remote GitHub PR comments and status updates)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

